# Local development: backend API (default PORT in cebee-backend-api is 3001)
REACT_APP_API_URL=http://localhost:3001/api

# Optional: tunnel (ngrok) to a remote/local API — no trailing slash; must include /api
# REACT_APP_API_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev/api

# Production: leave unset to use relative /api (Vercel rewrites to api.cebeepredict.com)
